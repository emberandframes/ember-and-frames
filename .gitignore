# This repository is public and every tracked file is served to visitors.
# Nothing below belongs in it. The brand strategy workspace is a separate,
# unversioned folder; only the two form pages and fonts.css ever cross over.

# Credentials
.env
.env.*
*.pem
*.key
*.p12
*.pfx
id_rsa*
credentials.json
client_secret*.json
service-account*.json
*.gs

# Brand strategy material that belongs outside this repo
Worklog/
worklog/
Pricing*/
Guidelines*/
*Master-Tracker*
*_Backend*
*.xlsx
*.pptx
*.docx

# Local authoring tooling. Reusable across projects, no part of the served site.
# Anchored to the repository root so a future .github/agents/ stays trackable.
/agents/
/skills/

# Claude Code local files: personal settings, local memory and session state.
.claude/
CLAUDE.local.md

# Lifestyle and Products placeholders, kept locally for reference now that both
# pages are live. Hospitality's placeholders are still in use, so they stay tracked.
assets/media/placeholders/lifestyle*.svg
assets/media/placeholders/products*.svg

# Backups and scratch
*.bak
*.orig
*.old
*~
*.BEFORE_*
_scratch/
_drafts/
# Probe page written by skills/launch-qa/scripts/font-metrics.mjs. It deletes it
# on a clean exit, but a killed process leaves it behind and it must never ship.
_font-metrics.html

# OS and editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Console logs, screenshots and traces from the Playwright MCP browser. Only the
# logs were caught by *.log, so a screenshot would have shown up as committable.
.playwright-mcp/

# Dependencies and build noise
node_modules/
__pycache__/
*.pyc
*.log
